<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>AppInfo</AssemblyName>
    <Product>AppInfo</Product>
    <Description>Collect, display and optionally save information about the host application during startup.</Description>
    <RootNamespace>AppInformation</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>AppInfo</PackageId>
    <Title>AppInfo</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>app info logging manifest</PackageTags>
    <PackageProjectUrl>https://github.com/Reyhn3/AppInfo</PackageProjectUrl>
    <PackageLicenseUrl>https://github.com/Reyhn3/AppInfo/blob/main/LICENSE</PackageLicenseUrl>
    <RepositoryUrl>https://github.com/Reyhn3/AppInfo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <Target Name="InjectPackageReleaseNotesFromFile" BeforeTargets="GenerateNuspec" Condition="Exists('$(MSBuildProjectDirectory)/../../CHANGELOG.md')">
    <PropertyGroup>
      <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/../../CHANGELOG.md"))</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
